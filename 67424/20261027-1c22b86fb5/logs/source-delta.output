diff --git a/src/ray/core_worker/core_worker.cc b/src/ray/core_worker/core_worker.cc
index 13c9f0e9d2..bbf9af6e95 100644
--- a/src/ray/core_worker/core_worker.cc
+++ b/src/ray/core_worker/core_worker.cc
@@ -488,6 +488,16 @@ CoreWorker::CoreWorker(
     absl::MutexLock lock(&wait_async_->mu);
     wait_async_->memory_store = memory_store_.get();
   }
+  // Objects can go out of scope through internal reference-counter paths that
+  // have no caller to hand a `deleted` vector to (e.g. when a borrower drops the
+  // last reference and this owner is notified asynchronously). Let the reference
+  // counter delete those objects' in-process values itself so the memory-store
+  // entries do not leak. Capture the memory store by value so the callback stays
+  // valid for as long as the reference counter holds it.
+  reference_counter_->SetMemoryStoreDeleteCallback(
+      [memory_store = memory_store_](const std::vector<ObjectID> &deleted) {
+        memory_store->Delete(deleted);
+      });
   RAY_CHECK(RayConfig::instance().max_free_local_objects_batch_size() > 0)
       << "max_free_local_objects_batch_size must be positive, got "
       << RayConfig::instance().max_free_local_objects_batch_size();
diff --git a/src/ray/core_worker/core_worker.h b/src/ray/core_worker/core_worker.h
index 6e2c83fc05..932d5b924b 100644
--- a/src/ray/core_worker/core_worker.h
+++ b/src/ray/core_worker/core_worker.h
@@ -455,8 +455,11 @@ class CoreWorker : public std::enable_shared_from_this<CoreWorker> {
   void RemoveLocalReference(const ObjectID &object_id) {
     std::vector<ObjectID> deleted;
     reference_counter_->RemoveLocalReference(object_id, &deleted);
-    // TODO(sang): This seems bad... We should delete the memory store
-    // properly from reference counter.
+    // Delete the in-process value of objects that went out of scope on this
+    // call. Internal reference-counter paths that have no `deleted` vector to
+    // report through (e.g. a borrower dropping the last reference) clean up the
+    // memory store themselves via the callback registered in the CoreWorker
+    // constructor (see ReferenceCounter::SetMemoryStoreDeleteCallback).
     memory_store_->Delete(deleted);
   }
 
diff --git a/src/ray/core_worker/reference_counter.cc b/src/ray/core_worker/reference_counter.cc
index a2cbe3735f..c949452203 100644
--- a/src/ray/core_worker/reference_counter.cc
+++ b/src/ray/core_worker/reference_counter.cc
@@ -776,6 +776,12 @@ void ReferenceCounter::DeleteReferenceInternal(ReferenceTable::iterator it,
     OnObjectOutOfScopeOrFreed(it);
     if (deleted != nullptr) {
       deleted->push_back(id);
+    } else if (delete_from_memory_store_ != nullptr) {
+      // There is no caller-provided vector to report this object through
+      // (e.g. a borrower dropped the last reference and we were notified
+      // asynchronously). Delete the object's in-process value directly so its
+      // memory-store entry does not leak.
+      delete_from_memory_store_({id});
     }
 
     auto index_it = reconstructable_owned_objects_index_.find(id);
@@ -1471,6 +1477,12 @@ void ReferenceCounter::SetReleaseLineageCallback(
   on_lineage_released_ = callback;
 }
 
+void ReferenceCounter::SetMemoryStoreDeleteCallback(
+    std::function<void(const std::vector<ObjectID> &)> callback) {
+  RAY_CHECK(delete_from_memory_store_ == nullptr);
+  delete_from_memory_store_ = std::move(callback);
+}
